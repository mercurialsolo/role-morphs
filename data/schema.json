{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mercurialsolo/role-morphs/blob/main/data/schema.json",
  "title": "Role morphs",
  "description": "One row per observed role transformation. A row is a claim, and evidence_type says how strong the claim is.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "discipline",
      "layer",
      "was",
      "becomes",
      "morph",
      "evidence_type",
      "source_url",
      "date_observed"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Stable slug, derived from discipline + was + becomes."
      },
      "discipline": {
        "type": "string",
        "enum": [
          "Software",
          "Product",
          "Science",
          "Legal",
          "Medicine",
          "The firm"
        ]
      },
      "layer": {
        "type": "string",
        "enum": [
          "Operational",
          "Decision",
          "Structural"
        ],
        "description": "Operational work is automated first, decision work last. Structural means the shape of the job itself changed."
      },
      "was": {
        "type": "string",
        "minLength": 2,
        "description": "The role as it was scoped before."
      },
      "becomes": {
        "type": "string",
        "minLength": 2,
        "description": "The role as it is scoped now."
      },
      "morph": {
        "type": "string",
        "minLength": 5,
        "description": "What actually changed, in one line."
      },
      "evidence_type": {
        "type": "string",
        "enum": [
          "Named study",
          "Job posting",
          "Research team page",
          "Industry reporting",
          "Vendor claim",
          "Argued only"
        ],
        "description": "Ordered strongest to weakest. 'Argued only' means no source observed the role; it is an argument."
      },
      "source_url": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^https?://",
        "description": "Absolute URL. Every row must be checkable, with one exception: an 'Argued only' row may have no source, because that is precisely what the grade means. Such a row must carry a note saying so."
      },
      "note": {
        "type": [
          "string",
          "null"
        ],
        "description": "Caveat, sample size, or what the source does not say."
      },
      "employer": {
        "type": [
          "string",
          "null"
        ],
        "description": "Named employer when the row came from one board."
      },
      "date_observed": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$",
        "description": "YYYY-MM the row was last checked against its source."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "evidence_type": {
              "not": {
                "const": "Argued only"
              }
            }
          }
        },
        "then": {
          "properties": {
            "source_url": {
              "type": "string"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "evidence_type": {
              "const": "Argued only"
            }
          }
        },
        "then": {
          "required": [
            "note"
          ],
          "properties": {
            "note": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    ]
  }
}
